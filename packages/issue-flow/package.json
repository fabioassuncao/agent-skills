{
  "name": "issue-flow",
  "version": "0.20.0",
  "description": "Unified CLI for orchestrating the full issue-flow pipeline via Claude Code, Codex CLI, Cursor CLI, Antigravity CLI or OpenCode CLI",
  "type": "module",
  "bin": {
    "issue-flow": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run skills:sync && npm run build:cli",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke": "bash scripts/smoke-issue-providers.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "fix": "biome check --write . && tsc --noEmit",
    "prepack": "npm run skills:check && npm run build",
    "prepublishOnly": "npm run skills:check && npm run skills:test && npm run lint && npm run typecheck && npm test",
    "preversion": "node scripts/git-version.mjs check",
    "postversion": "node scripts/git-version.mjs commit",
    "skills:sync": "node scripts/skills-build.mjs",
    "skills:check": "node scripts/skills-check.mjs",
    "skills:test": "node --test scripts/skills.test.mjs",
    "skills:install-test": "node scripts/skills-install-test.mjs",
    "skills:eval": "node scripts/skills-eval.mjs",
    "skills:benchmark": "node scripts/skills-benchmark.mjs",
    "skills:cli-test": "node scripts/skills-cli-test.mjs",
    "build:cli": "tsup",
    "context:measure": "node scripts/architecture-benchmark.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "prompts",
    "web"
  ],
  "keywords": [
    "ai",
    "agent",
    "claude",
    "codex",
    "cursor",
    "antigravity",
    "opencode",
    "automation",
    "cli",
    "pipeline",
    "headless",
    "issue-flow",
    "github"
  ],
  "license": "MIT",
  "author": "Fábio Assunção",
  "homepage": "https://github.com/fabioassuncao/issue-flow#readme",
  "bugs": {
    "url": "https://github.com/fabioassuncao/issue-flow/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fabioassuncao/issue-flow.git",
    "directory": "packages/issue-flow"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "listr2": "^10.2.1",
    "ora": "^8.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/node": "^22.14.0",
    "esbuild": "^0.28.2",
    "mdast-util-from-markdown": "^2.0.3",
    "skills": "1.5.23",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "yaml": "^2.9.0"
  }
}
