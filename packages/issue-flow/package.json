{
  "name": "issue-flow",
  "version": "0.18.0",
  "description": "Unified CLI for orchestrating the full issue-flow pipeline via Claude Code, Codex CLI, Cursor CLI or Antigravity CLI",
  "type": "module",
  "bin": {
    "issue-flow": "./dist/cli.js"
  },
  "scripts": {
    "prebuild": "npm run skills:sync",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run skills:sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke": "bash scripts/smoke-issue-providers.sh",
    "skills:sync": "node ../../scripts/sync-prompt-contracts.mjs --write",
    "skills:check": "node ../../scripts/sync-prompt-contracts.mjs --check && node ../../scripts/validate-skills.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "fix": "biome check --write . && tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "preversion": "node scripts/git-version.mjs check",
    "postversion": "node scripts/git-version.mjs commit",
    "skills:build": "node ../../scripts/build-skills-tree.mjs --out dist/skills",
    "skills:verify": "npm run skills:build && node ../../scripts/validate-skills.mjs --tree dist/skills"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "prompts",
    "web"
  ],
  "keywords": [
    "ai",
    "agent",
    "claude",
    "codex",
    "cursor",
    "antigravity",
    "automation",
    "cli",
    "pipeline",
    "headless",
    "issue-flow",
    "github"
  ],
  "license": "MIT",
  "author": "Fábio Assunção",
  "homepage": "https://github.com/fabioassuncao/issue-flow#readme",
  "bugs": {
    "url": "https://github.com/fabioassuncao/issue-flow/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fabioassuncao/issue-flow.git",
    "directory": "packages/issue-flow"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "listr2": "^10.2.1",
    "ora": "^8.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/node": "^22.14.0",
    "github-slugger": "^2.0.0",
    "marked": "^18.0.11",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "yaml": "^2.9.0"
  }
}
