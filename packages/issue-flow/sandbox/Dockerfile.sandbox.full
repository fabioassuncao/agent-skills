FROM debian:bookworm-slim

# The `full` sandbox image — the upstream's, verbatim (phase 12 parity), kept for
# the repositories that need what it carries: a Rust toolchain, asciinema, Bun,
# Playwright with Chromium, the AWS CLI and the Mermaid CLI.
#
# Since phase 13 it is **not** the default. `Dockerfile.sandbox` is, and it holds
# only what an agent needs to take an issue to a Pull Request (§14, stage 2:
# "minimal image as the default, the current one as `full`"). Name whichever one
# you built in the docker profile's `image`.
#
# Note that the `sudo` grant below is inert under the launch flags this project
# now uses: `--security-opt no-new-privileges` stops every setuid binary from
# raising privileges. It is kept because this file is the upstream's image and
# parity is what it is for. Install what you need into the image.

# ── System packages ───────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git unzip openssh-client build-essential sudo \
    && rm -rf /var/lib/apt/lists/*

# ── Node.js 22 ────────────────────────────────────────────────────────────────
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── GitHub CLI ────────────────────────────────────────────────────────────────
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# ── Rust toolchain (needed for asciinema) ────────────────────────────────────
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:$PATH"

# ── asciinema (cargo build for latest) ───────────────────────────────────────
RUN cargo install asciinema

# ── Bun ───────────────────────────────────────────────────────────────────────
# Bun is a tool available *inside* the sandbox, for the repositories the agent
# works on. It is not this project's runtime — ADR-01 discards it as such.
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:$PATH"

# ── Playwright + Chromium ─────────────────────────────────────────────────────
RUN bun add -g @playwright/test \
    && bunx playwright install chromium --with-deps \
    && rm -rf /var/lib/apt/lists/* /tmp/bunx-*

# ── AWS CLI ───────────────────────────────────────────────────────────────────
# The archive is published per architecture and the upstream hardcodes x86_64,
# which fails the whole build on an arm64 host. The name is derived instead —
# the smallest change that makes the port actually buildable.
RUN AWS_ARCH="$(dpkg --print-architecture)" \
    && case "$AWS_ARCH" in \
         amd64) AWS_ARCH=x86_64 ;; \
         arm64) AWS_ARCH=aarch64 ;; \
         *) echo "unsupported architecture for the AWS CLI: $AWS_ARCH" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${AWS_ARCH}.zip" -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/aws /tmp/awscliv2.zip
ENV AWS_DEFAULT_REGION=auto

# ── Claude Code ───────────────────────────────────────────────────────────────
RUN curl -fsSL https://claude.ai/install.sh | bash
ENV PATH="/root/.local/bin:$PATH"

# ── npm globals (install to /usr/local so bins land on PATH for all users) ────
ENV NPM_CONFIG_PREFIX=/usr/local

# ── Codex ─────────────────────────────────────────────────────────────────────
RUN npm i -g @openai/codex

# ── Mermaid CLI ───────────────────────────────────────────────────────────────
# Skip puppeteer's own Chromium download; reuse Playwright's headless shell
# (the full "chrome" binary crashes with a crashpad handler error in containers)
RUN PUPPETEER_SKIP_DOWNLOAD=true npm i -g @mermaid-js/mermaid-cli \
    && CHROMIUM=$(find /root/.cache/ms-playwright -name 'chrome-headless-shell' -executable -type f | head -1) \
    && printf '{"args":["--no-sandbox","--disable-setuid-sandbox"],"executablePath":"%s"}\n' "$CHROMIUM" \
       > /root/.puppeteerrc.json

# ── Allow non-root UID (--user) to access tools installed in /root ───────────
# The container runs as the host user so files created in the mounted worktree
# are owned by the right UID/GID. Give UID 1000 a proper passwd entry,
# passwordless sudo, and full access to /root.
RUN chmod -R 777 /root \
    && useradd -u 1000 -g 100 -d /root -s /bin/bash -M agent \
    && echo "agent ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/agent \
    && chmod 0440 /etc/sudoers.d/agent

# ── Entrypoint (run explicitly via docker exec, not on container start) ──────
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
